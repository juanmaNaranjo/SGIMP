# ═══════════════════════════════════════════════
# SGIMP — Variables para Docker Compose
# Copiar a ".env" (en esta misma carpeta) y editar:
#     cp .env.example .env
# El archivo .env NO se sube a Git.
# ═══════════════════════════════════════════════

# Clave de PostgreSQL. Usar solo letras y números (los símbolos como @ / : rompen la URL de conexión).
POSTGRES_PASSWORD=cambia_esta_clave_123

# Clave para firmar los JWT. Generar con:  openssl rand -hex 32
SECRET_KEY=cambia_esto_por_un_valor_aleatorio_de_64_caracteres

# API key de Anthropic (opcional: sin ella el asistente IA muestra un aviso, el resto del sistema funciona)
ANTHROPIC_API_KEY=

# Orígenes permitidos por CORS (separados por coma). En producción: https://tu-dominio.com
ALLOWED_ORIGINS=http://localhost:3000
