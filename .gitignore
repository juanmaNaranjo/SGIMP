# ═══════════════════════════════════════════════
# SGIMP — .gitignore
# ═══════════════════════════════════════════════

# ── Secretos y variables de entorno (NUNCA subir) ──
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# ── Datos generados en runtime ──
uploads/
backend/uploads/
backups/
*.sql
*.sql.gz
*.dump
*.sqlite3
*.db

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Modelos ML entrenados / artefactos pesados ──
*.joblib
*.pkl
*.h5

# ── Node / Frontend ──
node_modules/
frontend/dist/
frontend/build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker local ──
docker-compose.override.yml

# ── Logs ──
*.log
logs/

# ── IDEs ──
.vscode/
.idea/
*.swp
*.swo

# ── Sistema operativo ──
.DS_Store
Thumbs.db
desktop.ini

# ── Entregables comprimidos ──
*.zip
*.tar.gz
