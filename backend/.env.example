# === SGIMP - Sistema de Gestión Integral de Materias Primas ===

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sgimp_db
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/sgimp_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_NAME=SGIMP
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Email (SMTP)
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-password
MAIL_FROM=noreply@sgimp.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# Alert thresholds (days)
EXPIRY_ALERT_RED=30
EXPIRY_ALERT_ORANGE=90
EXPIRY_ALERT_YELLOW=180

# Scheduler
SCHEDULER_ALERT_HOUR=8
SCHEDULER_ALERT_MINUTE=0
